<Window x:Class="DiplomDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="МГУТУ: электронный журнал"
        Width="1320"
        Height="820"
        MinWidth="1120"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F6F7F4"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#101820"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#5F6F73"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0F6F73"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#083F45"/>
        <SolidColorBrush x:Key="CoralBrush" Color="#E85D43"/>
        <SolidColorBrush x:Key="SoftBrush" Color="#EEF6F3"/>
        <SolidColorBrush x:Key="LineBrush" Color="#DFE7E4"/>
        <SolidColorBrush x:Key="TableHeaderBrush" Color="#F7F8F4"/>
        <SolidColorBrush x:Key="RowHoverBrush" Color="#F1F7F4"/>
        <SolidColorBrush x:Key="RowSelectedBrush" Color="#DCEFED"/>
        <SolidColorBrush x:Key="GoldBrush" Color="#F6B64A"/>
        <SolidColorBrush x:Key="GraphiteBrush" Color="#172326"/>
        <ImageBrush x:Key="PatternBrush" ImageSource="Assets/pattern.png" Stretch="UniformToFill" Opacity="0.34"/>

        <DropShadowEffect x:Key="SoftShadow" BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="0.11" Color="#172326"/>
        <DropShadowEffect x:Key="GlowShadow" BlurRadius="26" ShadowDepth="0" Opacity="0.22" Color="#0F6F73"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>

        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>

        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0F6F73"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="17,10"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Effect" Value="{StaticResource GlowShadow}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#F7F8F4"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="#DCE6E2"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DCE8E6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,11"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#26383B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Root" Property="Background" Value="#F6B64A"/>
                                <Setter Property="Foreground" Value="#101820"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Root" Property="Background" Value="#FCFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Root" Property="Background" Value="#FCFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#C8D8DA"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="44"/>
            <Setter Property="ColumnHeaderHeight" Value="44"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="AlternatingRowBackground" Value="#FBFCF8"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource TableHeaderBrush}"/>
            <Setter Property="Foreground" Value="#42595E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper"
                                   HorizontalAlignment="Left"
                                   Width="8"
                                   Cursor="SizeWE"
                                   Background="Transparent"/>
                            <Thumb x:Name="PART_RightHeaderGripper"
                                   HorizontalAlignment="Right"
                                   Width="8"
                                   Cursor="SizeWE"
                                   Background="Transparent"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#EEF7F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#EEF4F4"
                                BorderThickness="0,0,0,1">
                            <SelectiveScrollingGrid>
                                <SelectiveScrollingGrid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </SelectiveScrollingGrid.ColumnDefinitions>
                                <SelectiveScrollingGrid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </SelectiveScrollingGrid.RowDefinitions>
                                <DataGridCellsPresenter Grid.Column="1"
                                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                <DataGridDetailsPresenter Grid.Column="1"
                                                          Grid.Row="1"
                                                          Visibility="{TemplateBinding DetailsVisibility}"/>
                            </SelectiveScrollingGrid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="AlternationIndex" Value="1">
                                <Setter TargetName="Root" Property="Background" Value="#F8FCFC"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource RowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource RowSelectedBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="LoginView">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="0.85*"/>
            </Grid.ColumnDefinitions>

            <Border Margin="24" CornerRadius="8" Effect="{StaticResource SoftShadow}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#101820" Offset="0"/>
                        <GradientStop Color="#0F6F73" Offset="0.58"/>
                        <GradientStop Color="#F6B64A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="42">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <Border Width="54" Height="54" CornerRadius="8" Background="#FFFFFF" HorizontalAlignment="Left">
                            <TextBlock Text="ИС" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="18" Foreground="#0F6F73"/>
                        </Border>
                        <TextBlock Text="Информационная система учета посещаемости и успеваемости студентов"
                                   Foreground="White"
                                   FontSize="34"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,32,0,12"/>
                        <TextBlock Text="ПК-версия дипломного проекта для работы с PostgreSQL-базой diplom. Электронные журналы, расписание, зачетная книжка и разграничение ролей в одном приложении."
                                   Foreground="#E7F3F2"
                                   FontSize="16"
                                   LineHeight="24"
                                   TextWrapping="Wrap"
                                   Width="620"
                                   HorizontalAlignment="Left"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            CornerRadius="8"
                            ClipToBounds="True"
                            Margin="0,28,0,12"
                            MaxHeight="340"
                            VerticalAlignment="Center"
                            Background="#18FFFFFF">
                        <Grid>
                            <Image Source="Assets/hero-campus.png" Stretch="UniformToFill" Opacity="0.92"/>
                            <Border Background="#22000000"/>
                            <StackPanel VerticalAlignment="Bottom" Margin="24">
                                <TextBlock Text="Единое учебное пространство"
                                           Foreground="White"
                                           FontSize="22"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="журналы, расписание, зачетка и аналитика в одном окне"
                                           Foreground="#E7F3F2"
                                           FontSize="14"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <UniformGrid Grid.Row="2" Columns="3" Margin="0,34,0,0">
                        <Border Background="#1BFFFFFF" CornerRadius="8" Padding="18" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="PostgreSQL" Foreground="White" FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock Text="единая база diplom" Foreground="#E7F3F2" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1BFFFFFF" CornerRadius="8" Padding="18" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="WPF / C#" Foreground="White" FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock Text="нативное окно Windows" Foreground="#E7F3F2" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1BFFFFFF" CornerRadius="8" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Роли" Foreground="White" FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock Text="админ, преподаватель, студент" Foreground="#E7F3F2" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="24">
                <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" CornerRadius="8" Padding="34" Effect="{StaticResource SoftShadow}">
                    <StackPanel>
                        <TextBlock Text="Вход в систему" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="Используются существующие учетные записи Django." Style="{StaticResource MutedTextStyle}" Margin="0,8,0,28"/>

                        <TextBlock Text="Логин" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBox x:Name="UsernameBox" Text="teacher1" Margin="0,0,0,16"/>

                        <TextBlock Text="Пароль" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <PasswordBox x:Name="PasswordBox" Password="teacher12345" Margin="0,0,0,20"/>

                        <Button Content="Войти" Style="{StaticResource PrimaryButton}" Click="LoginButton_Click"/>
                        <TextBlock x:Name="LoginErrorText" Foreground="{StaticResource CoralBrush}" TextWrapping="Wrap" Margin="0,16,0,0"/>

                        <Border Background="#F7F8F4" BorderBrush="#DFE7E4" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,26,0,0">
                            <TextBlock Text="Демо: teacher1 / teacher12345 или student1 / student12345. Администратор входит своей учетной записью superuser."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="ShellView" Visibility="Collapsed">
            <Grid.Background>
                <ImageBrush ImageSource="Assets/pattern.png" Stretch="UniformToFill" Opacity="0.28"/>
            </Grid.Background>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="282"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource GraphiteBrush}">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Border Width="54" Height="54" CornerRadius="8" Background="White" HorizontalAlignment="Left">
                            <TextBlock Text="ИС" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="18" Foreground="#0F6F73"/>
                        </Border>
                        <TextBlock Text="МГУТУ журнал" Foreground="White" FontWeight="SemiBold" FontSize="22" Margin="0,18,0,4"/>
                        <TextBlock Text="ПК-клиент дипломного проекта" Foreground="#AFC2C1" FontSize="13"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#26383B" CornerRadius="8" Padding="14" Margin="0,28,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="8" ClipToBounds="True" Background="#FFFFFF">
                                <Image x:Name="CurrentAvatarImage" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="CurrentUserText" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="CurrentRoleText" Foreground="#AFC2C1" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Button x:Name="AdminOverviewButton" Content="Сводка" Style="{StaticResource NavButton}" Click="AdminOverviewButton_Click"/>
                            <Button x:Name="AdminUsersButton" Content="Пользователи" Style="{StaticResource NavButton}" Click="AdminUsersButton_Click"/>
                            <Button x:Name="AdminRolesButton" Content="Права и роли" Style="{StaticResource NavButton}" Click="AdminRolesButton_Click"/>
                            <Button x:Name="AdminDirectoriesButton" Content="Справочники" Style="{StaticResource NavButton}" Click="AdminDirectoriesButton_Click"/>
                            <Button x:Name="AdminCoursesButton" Content="Электронные журналы" Style="{StaticResource NavButton}" Click="AdminCoursesButton_Click"/>
                            <Button x:Name="AdminScheduleButton" Content="Расписание" Style="{StaticResource NavButton}" Click="AdminScheduleButton_Click"/>
                            <Button x:Name="AdminScheduleManageButton" Content="Редактор расписания" Style="{StaticResource NavButton}" Click="AdminScheduleManageButton_Click"/>
                            <Button x:Name="AdminAnalyticsButton" Content="Аналитика и риски" Style="{StaticResource NavButton}" Click="AdminAnalyticsButton_Click"/>

                            <Button x:Name="TeacherDashboardButton" Content="Панель преподавателя" Style="{StaticResource NavButton}" Click="TeacherDashboardButton_Click"/>
                            <Button x:Name="TeacherCoursesButton" Content="Мои курсы" Style="{StaticResource NavButton}" Click="TeacherCoursesButton_Click"/>
                            <Button x:Name="TeacherJournalButton" Content="Журнал преподавателя" Style="{StaticResource NavButton}" Click="TeacherJournalButton_Click"/>
                            <Button x:Name="TeacherFinalGradesButton" Content="Итоговые оценки" Style="{StaticResource NavButton}" Click="TeacherFinalGradesButton_Click"/>
                            <Button x:Name="TeacherScheduleButton" Content="Мое расписание" Style="{StaticResource NavButton}" Click="TeacherScheduleButton_Click"/>
                            <Button x:Name="TeacherAnalyticsButton" Content="Учебные риски" Style="{StaticResource NavButton}" Click="TeacherAnalyticsButton_Click"/>

                            <Button x:Name="StudentDashboardButton" Content="Личный кабинет" Style="{StaticResource NavButton}" Click="StudentDashboardButton_Click"/>
                            <Button x:Name="StudentJournalButton" Content="Оценки и посещаемость" Style="{StaticResource NavButton}" Click="StudentJournalButton_Click"/>
                            <Button x:Name="StudentRecordBookButton" Content="Зачетная книжка" Style="{StaticResource NavButton}" Click="StudentRecordBookButton_Click"/>
                            <Button x:Name="StudentScheduleButton" Content="Расписание группы" Style="{StaticResource NavButton}" Click="StudentScheduleButton_Click"/>
                            <Button x:Name="StudentRecommendationsButton" Content="Рекомендации" Style="{StaticResource NavButton}" Click="StudentRecommendationsButton_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="3" Content="Выйти" Style="{StaticResource NavButton}" Click="LogoutButton_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="White" CornerRadius="8" Padding="22" Effect="{StaticResource SoftShadow}" Margin="0,0,0,16">
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="PageTitleText" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock x:Name="PageSubtitleText" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EEF6F3" BorderBrush="#DCE6E2" BorderThickness="1" CornerRadius="8" Padding="16,10">
                            <TextBlock Text="БД: diplom / localhost:5432" Foreground="#0F6F73" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>

                <ContentControl x:Name="BodyHost" Grid.Row="1"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
